{
  "name": "@nkzw/oxc-transform-fbtee-binding-linux-arm64-musl",
  "version": "3.2.0",
  "description": "Native Rust Oxc transform for fbtee.",
  "keywords": [
    "fbt",
    "fbtee",
    "i18n",
    "oxc",
    "transform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkzw-tech/fbtee.git",
    "directory": "packages/oxc-transform-fbtee"
  },
  "license": "MIT",
  "main": "oxc-transform-fbtee.linux-arm64-musl.node",
  "files": [
    "oxc-transform-fbtee.linux-arm64-musl.node"
  ],
  "scripts": {
    "prepack": "node -e \"const{existsSync}=require('node:fs');const{main}=require('./package.json');if(!existsSync(main))throw new Error('Missing native binding: '+main)\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64"
  ],
  "libc": [
    "musl"
  ]
}
