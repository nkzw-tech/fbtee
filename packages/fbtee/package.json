{
  "name": "fbtee",
  "version": "5.0.0",
  "description": "The JavaScript & React Internationalization Framework.",
  "keywords": [
    "fbt",
    "globalization",
    "i18n",
    "internationalization",
    "l10n",
    "localization",
    "react",
    "translation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkzw-tech/fbtee.git",
    "directory": "packages/fbtee"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "react-server": "./lib/index-core.mjs",
      "import": "./lib/index.mjs",
      "default": "./lib/index.mjs"
    },
    "./ReactTypes": {
      "types": "./ReactTypes.d.ts"
    },
    "./ReactTypes.d.ts": {
      "types": "./ReactTypes.d.ts"
    },
    "./server": {
      "types": "./lib/index-server.d.mts",
      "node": "./lib/index-server.mjs",
      "import": "./lib/index-core.mjs",
      "default": "./lib/index-core.mjs"
    },
    "./Strings.json": "./Strings.json"
  },
  "scripts": {
    "benchmark": "node --expose-gc scripts/benchmark-runtime.mjs",
    "build": "pnpm build:source && pnpm build:prepend && tsdown lib-tmp/index.tsx lib-tmp/index-server.tsx lib-tmp/index-core.tsx -d lib --target=node22 --format=esm --clean --dts",
    "build:fbtee-strings": "pnpm fbtee collect --include-default-strings=false --src src/*.tsx --out Strings.json && ./scripts/rewrite-filepaths.ts",
    "build:prepend": "node -e \"const file = './lib-tmp/list.tsx'; fs.writeFileSync(file, '// @ts-nocheck\\n' + fs.readFileSync(file, 'utf8'));\"",
    "build:source": "node scripts/build-source.mjs",
    "test": "NODE_ENV=development node --test test/scoped-runtime.mjs && NODE_ENV=development node --conditions=react-server --test test/scoped-runtime.mjs && NODE_ENV=production node --test test/scoped-runtime.mjs && NODE_ENV=production node --conditions=react-server --test test/scoped-runtime.mjs"
  },
  "dependencies": {
    "invariant": "^2.2.4"
  },
  "devDependencies": {
    "@nkzw/fbtee-compiler": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
