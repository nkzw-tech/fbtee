// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Test enum hash keys generation should generate single hash key for fbt with enum under regular mode 1`] = `
"import { fbt } from "fbtee";
fbt._({
  a: "Foo A",
  b: "Foo B",
  c: "Foo C"
}, [fbt._enum('a', {
  "a": "A",
  "b": "B",
  "c": "C"
})], {
  hk: "NT3sR"
});"
`;

